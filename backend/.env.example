ENVIRONMENT=development
# Set a unique long random value for production. Development persists a private generated value.
SECRET_KEY=
DATABASE_URL=sqlite:///./data/garden.db
# Explicit opt-in for local testing only. Use aliyun for real SMS.
SMS_PROVIDER=aliyun
SMS_DEV_CODE=123456
# For real SMS, set SMS_PROVIDER=aliyun and configure these independently.
ALIYUN_DYPNS_ACCESS_KEY_ID=
ALIYUN_DYPNS_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_SIGN_NAME=
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
AI_API_BASE_URL=https://api.aicodewith.com/v1
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=180
AI_DAILY_QUESTION_LIMIT=20

# Community: comma-separated admin phone numbers, extra comment keywords that need review, and public image directory.
ADMIN_PHONES=
SENSITIVE_WORDS=
MEDIA_DIR=
